      <guid>http://localhost:1313/docs/tools-cheatsheet/approved-tools-map/</guid>
      <description>&lt;h1 id=&#34;existing-tools--challenge-workflows&#34;&gt;Existing Tools → Challenge Workflows&lt;a class=&#34;anchor&#34; href=&#34;#existing-tools--challenge-workflows&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;p&gt;This map links your existing 39 &lt;a href=&#34;../../ajcbbc_allow_tools/&#34;&gt;AJCBBC tool notes&lt;/a&gt; to the new technique collections. It describes use, not an expanded competition allowlist. Optional dependencies/plugins remain subject to event rules.&lt;/p&gt;&#xA;&lt;h2 id=&#34;decode-inspect-and-prepare&#34;&gt;Decode, inspect, and prepare&lt;a class=&#34;anchor&#34; href=&#34;#decode-inspect-and-prepare&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Workflow&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/cyberchef/&#34;&gt;CyberChef&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Encodings, XOR, compression, supplied crypto parameters&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../cyberchef-cheatsheet/&#34;&gt;Visual recipes&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/python3/&#34;&gt;Python 3&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Repeat a byte transformation or decode structured data&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../python-library/&#34;&gt;Snippet library&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/uv/&#34;&gt;uv&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Prepare a permitted isolated Python dependency environment&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/python-snippets/&#34;&gt;Reversing helpers&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/wsl/&#34;&gt;WSL&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Run Linux CLI tools from Windows&lt;/td&gt;&#xA;          &lt;td&gt;All CLI workflows; mind Windows/WSL paths&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/notepad_plus_plus/&#34;&gt;Notepad++&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect text, encodings, line endings and regex matches&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/text-unicode/&#34;&gt;Unicode/text&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/hxd/&#34;&gt;HxD&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect offsets, signatures, byte changes&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/triage/&#34;&gt;File triage&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/xxd/&#34;&gt;xxd&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Reversible byte/hex inspection&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/strings-encodings/&#34;&gt;Reversing strings&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/strings/&#34;&gt;strings&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Fast ASCII/UTF-16 string triage&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/static-analysis/&#34;&gt;Static analysis&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/xz/&#34;&gt;xz&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;XZ/LZMA archive/container clue&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/archives-carving/&#34;&gt;Archives/carving&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;web&#34;&gt;Web&lt;a class=&#34;anchor&#34; href=&#34;#web&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Workflow&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/google_chrome/&#34;&gt;Chrome&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect requests, DOM, JS, storage, WebSocket messages&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../web-expl/methodology/&#34;&gt;First 10 minutes&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/burp_suite_community/&#34;&gt;Burp Community&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Capture/replay exact HTTP parameters and compare responses&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../web-expl/&#34;&gt;Web payload index&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/jq/&#34;&gt;jq&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect API JSON and structured exports&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../web-expl/graphql/&#34;&gt;GraphQL&lt;/a&gt; / &lt;a href=&#34;../../web-expl/nosqli/&#34;&gt;NoSQL&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;network-and-protocol-analysis&#34;&gt;Network and protocol analysis&lt;a class=&#34;anchor&#34; href=&#34;#network-and-protocol-analysis&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Workflow&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/openvpn_client/&#34;&gt;OpenVPN Client&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Challenge requires the supplied VPN&lt;/td&gt;&#xA;          &lt;td&gt;Establish access first; preserve route details&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/wireshark/&#34;&gt;Wireshark&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Explore packet conversations and follow streams&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/packet-triage/&#34;&gt;Packet triage&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/tshark/&#34;&gt;TShark&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Repeat filters, export fields/objects&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/http-streams/&#34;&gt;HTTP extraction&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/zeek/&#34;&gt;Zeek&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Summarize PCAP sessions at scale&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/protocols/&#34;&gt;Protocol overview&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/openssl/&#34;&gt;OpenSSL&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect certs/keys or explicit crypto parameters&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/tls-ssh/&#34;&gt;TLS / SSH&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/cannelloni/&#34;&gt;cannelloni&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Challenge provides a CAN-over-UDP tunnel&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/can-bus/&#34;&gt;CAN bus&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/can_utils/&#34;&gt;can-utils&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect/replay an authorized CAN interface/log&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/can-bus/&#34;&gt;CAN bus&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;images-documents-archives&#34;&gt;Images, documents, archives&lt;a class=&#34;anchor&#34; href=&#34;#images-documents-archives&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Workflow&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/exiftool/&#34;&gt;ExifTool&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Metadata, embedded comments, file-type mismatch&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/triage/&#34;&gt;Stego triage&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/binwalk/&#34;&gt;binwalk&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Embedded data signatures / container offsets&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/archives-carving/&#34;&gt;Archives/carving&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/zsteg/&#34;&gt;zsteg&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;PNG/BMP low-bit data candidates&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/images-lsb/&#34;&gt;Image LSB&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/zbar/&#34;&gt;ZBar&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Barcode/QR clue&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/png-jpeg/&#34;&gt;Image formats&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/pdf_viewer/&#34;&gt;PDF Viewer&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Layers, visible text, annotation clue&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/pdf-documents/&#34;&gt;PDF/documents&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/pdftotext/&#34;&gt;pdftotext&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Extract PDF text for searching&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/pdf-documents/&#34;&gt;PDF/documents&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/qpdf/&#34;&gt;qpdf&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Inspect PDF structure, streams, attachments&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/pdf-documents/&#34;&gt;PDF/documents&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;disk-and-memory-forensics&#34;&gt;Disk and memory forensics&lt;a class=&#34;anchor&#34; href=&#34;#disk-and-memory-forensics&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Next step&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/autopsy/&#34;&gt;Autopsy&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Filesystem image and timeline&lt;/td&gt;&#xA;          &lt;td&gt;Identify partition/filesystem → browse/recover artifacts&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/sleuth_kit/&#34;&gt;The Sleuth Kit&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Need reproducible partition/file extraction&lt;/td&gt;&#xA;          &lt;td&gt;Correct sector offset → list entries → extract exact inode&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/fsck_fat/&#34;&gt;fsck.fat&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;FAT corruption clue&lt;/td&gt;&#xA;          &lt;td&gt;Diagnose a copy before any repair&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/volatility3/&#34;&gt;Volatility 3&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Memory image&lt;/td&gt;&#xA;          &lt;td&gt;Identify OS/process → relevant plugin → export evidence&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/openssh_session_key_recovery/&#34;&gt;OpenSSH key recovery&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Matching Linux/OpenSSH memory evidence&lt;/td&gt;&#xA;          &lt;td&gt;Validate plugin/version/process preconditions&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/eric_zimmerman_tools/&#34;&gt;Eric Zimmerman&amp;rsquo;s Tools&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Windows event/artifact evidence&lt;/td&gt;&#xA;          &lt;td&gt;Choose parser matching artifact → correlate timestamp/context&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;reversing-and-cryptography&#34;&gt;Reversing and cryptography&lt;a class=&#34;anchor&#34; href=&#34;#reversing-and-cryptography&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Tool&lt;/th&gt;&#xA;          &lt;th&gt;Start with it when&lt;/th&gt;&#xA;          &lt;th&gt;Workflow&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/ghidra/&#34;&gt;Ghidra&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Native executable, data flow and decompilation&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/ghidra-cheatsheet/&#34;&gt;Ghidra cheatsheet&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/gdb/&#34;&gt;gdb&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Linux runtime registers/memory/checker&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/dynamic-debugging/&#34;&gt;Dynamic debugging&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/objdump/&#34;&gt;objdump&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Fast disassembly and section/import view&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/static-analysis/&#34;&gt;Static analysis&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/llvm_mc/&#34;&gt;llvm-mc&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Encode/decode an instruction for a known architecture&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/static-analysis/&#34;&gt;Static analysis&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/x64dbg/&#34;&gt;x64dbg&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Native Windows executable at runtime&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/dynamic-debugging/&#34;&gt;Dynamic debugging&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/dnspyex/&#34;&gt;dnSpyEx&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;.NET assembly, managed metadata and IL&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/dotnet/&#34;&gt;.NET reversing&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/rsactftool/&#34;&gt;RsaCtfTool&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;RSA key/ciphertext with exploitable conditions&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/python3/#cookbook-map&#34;&gt;Python crypto cookbook&lt;/a&gt;&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;one-complete-example&#34;&gt;One complete example&lt;a class=&#34;anchor&#34; href=&#34;#one-complete-example&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#d8dee9;background-color:#2e3440;-moz-tab-size:2;-o-tab-size:2;tab-size:2;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-text&#34; data-lang=&#34;text&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;PCAP&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → Wireshark protocol hierarchy&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → TShark HTTP object/stream extraction&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → identify exported file bytes&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → CyberChef decode only if evidence supports it&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → Ghidra for a native executable, zsteg for a suitable lossless image&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;  → Python helper reproduces the confirmed transform&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Tool output is a lead, not the final answer. Preserve the originating packet/file offset, exact operation, and verification result.&lt;/p&gt;</description>
    </item>
    <item>
      <title>Python · Offline Snippet Library</title>
      <link>http://localhost:1313/docs/tools-cheatsheet/python-library/</link>
      <pubDate>Mon, 01 Jan 0001 00:00:00 +0000</pubDate>
      <guid>http://localhost:1313/docs/tools-cheatsheet/python-library/</guid>
      <description>&lt;h1 id=&#34;offline-python-snippet-library&#34;&gt;Offline Python Snippet Library&lt;a class=&#34;anchor&#34; href=&#34;#offline-python-snippet-library&#34;&gt;&lt;/a&gt;&lt;/h1&gt;&#xA;&lt;p&gt;Ready-to-save helpers are grouped by artifact. Each guide explains inputs, command examples, output and limits; each script has &lt;code&gt;--help&lt;/code&gt;. Keep a local copy of the notes and the referenced &lt;code&gt;.py&lt;/code&gt; files before the event.&lt;/p&gt;&#xA;&lt;table&gt;&#xA;  &lt;thead&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;th&gt;Category&lt;/th&gt;&#xA;          &lt;th&gt;Guide&lt;/th&gt;&#xA;          &lt;th&gt;Examples&lt;/th&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/thead&gt;&#xA;  &lt;tbody&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;Web&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../web-expl/python-snippets/&#34;&gt;Web helpers&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Byte encodings, JWT decode/sign with known key, boolean SQL extraction&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;Network&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../network-expl/python-snippets/&#34;&gt;Network helpers&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Persistent protocol session, DNS reconstruction&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;Steganography&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../steganograph-expl/python-snippets/&#34;&gt;Stego helpers&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Bounded carving, explicit image LSB extraction, Unicode inspection&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;Reversing&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../reversing-expl/python-snippets/&#34;&gt;Reversing helpers&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Byte transforms, XOR, endianness, reversible checker templates&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;      &lt;tr&gt;&#xA;          &lt;td&gt;Crypto reference&lt;/td&gt;&#xA;          &lt;td&gt;&lt;a href=&#34;../../ajcbbc_allow_tools/python3/#cookbook-map&#34;&gt;Existing Python cookbook&lt;/a&gt;&lt;/td&gt;&#xA;          &lt;td&gt;Base encodings, classical ciphers, AES, ChaCha, hashes, RSA&lt;/td&gt;&#xA;      &lt;/tr&gt;&#xA;  &lt;/tbody&gt;&#xA;&lt;/table&gt;&#xA;&lt;h2 id=&#34;check-your-local-environment-once&#34;&gt;Check your local environment once&lt;a class=&#34;anchor&#34; href=&#34;#check-your-local-environment-once&#34;&gt;&lt;/a&gt;&lt;/h2&gt;&#xA;&lt;div class=&#34;highlight&#34;&gt;&lt;pre tabindex=&#34;0&#34; style=&#34;color:#d8dee9;background-color:#2e3440;-moz-tab-size:2;-o-tab-size:2;tab-size:2;-webkit-text-size-adjust:none;&#34;&gt;&lt;code class=&#34;language-bash&#34; data-lang=&#34;bash&#34;&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;python --version&#xA;&lt;/span&gt;&lt;/span&gt;&lt;span style=&#34;display:flex;&#34;&gt;&lt;span&gt;python web_helpers.py --help&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;p&gt;Some Windows setups use &lt;code&gt;py -3&lt;/code&gt; or &lt;code&gt;python3&lt;/code&gt;; substitute the actual installed command. Standard-library helpers do not need &lt;code&gt;pip&lt;/code&gt;. Optional package scripts clearly state the dependency, such as Pillow for decoded image pixels.&lt;/p&gt;</description>
    </item>
